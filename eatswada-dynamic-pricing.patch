index 0000000..65ebd56
--- /dev/null
+++ b/tests/ew-phase3.test.js
@@ -0,0 +1,271 @@
+'use strict';
+/* ================================================================
+   Phase 3 — cart / checkout quote.
+
+   Usage: node tests/ew-phase3.test.js
+
+   No dependencies. Tests the real modules (js/ew-quote.js, js/ew-bill.js,
+   js/ew-money.js) against the backend's actual quote shapes, and asserts
+   the source wiring of the cart page.
+
+   Backend reference (cloned backend, commit 2139abb):
+     controllers/pricingController.js   POST /pricing/quote
+     services/pricing/pricingOrchestrator.js   quote shape
+     services/pricing/profitabilityEngine.js   the three decisions
+     controllers/orderController.js     POST /orders (does NOT read quoteId)
+   ================================================================ */
+
+const fs = require('fs');
+const path = require('path');
+const root = path.resolve(__dirname, '..');
+function req(name) { return require(path.join(root, name)); }
+function read(f) { return fs.readFileSync(path.join(root, f), 'utf8'); }
+
+let passed = 0, failed = 0;
+const failures = [];
+function ok(label, cond) { if (cond) passed++; else { failed++; failures.push(label); } }
+function eq(label, a, b) { if (a === b) passed++; else { failed++; failures.push(label + ' — expected ' + JSON.stringify(b) + ' got ' + JSON.stringify(a)); } }
+function near(label, a, b, eps) {
+  if (Math.abs(Number(a) - Number(b)) <= (eps == null ? 0.005 : eps)) passed++;
+  else { failed++; failures.push(label + ' — expected ~' + b + ' got ' + a); }
+}
+
+const EWMoney = req('js/ew-money.js');
+const EWBill = req('js/ew-bill.js');
+/* ew-quote.js is UMD and picks up EWPricing/EWBill from the global root.
+   In the browser those come from the earlier <script> tags; here we install
+   them the same way before requiring the module. */
+globalThis.EWMoney = EWMoney;
+globalThis.EWBill = EWBill;
+globalThis.EWPricing = req('js/ew-pricing.js');
+const EWQuote = req('js/ew-quote.js');
+
+/* ── 1. Money formatting edge cases ─────────────────────────────── */
+eq('money: paise rounds half-up', EWMoney.paiseToRupees(12345), 123.45);
+eq('money: paise rounds to 2dp', EWMoney.paiseToRupees(1999), 19.99);
+eq('money: paise half-up on .5', EWMoney.paiseToRupees(1005), 10.05);
+eq('money: indian grouping 1,23,456.78', EWMoney.format(123456.78), '₹1,23,456.78');
+eq('money: whole number has no decimals', EWMoney.format(199), '₹199');
+eq('money: int format groups', EWMoney.formatInt(123456), '₹1,23,456');
+eq('money: negative kept', EWMoney.format(-25), '-₹25');
+eq('money: manual grouping fallback', EWMoney._manualIndianGroup(1234567.5), '12,34,567.5');
+eq('money: empty for null', EWMoney.format(null), '');
+eq('money: rupees->paise half-up', EWMoney.rupeesToPaise(10.005), 1001);
+
+/* ── 2. Bill rows come only from the quote ──────────────────────── */
+const profitableQuote = {
+  quoteId: 'q_1',
+  decision: 'PROFITABLE',
+  serviceable: true,
+  quoteExpiresAt: new Date(Date.now() + 60000).toISOString(),
+  bill: {
+    foodPayable: 240, foodUplift: 12, customerFoodSubtotal: 228,
+    deliveryFee: 35, deliverySubsidy: 0, smallOrderFee: 20, codFee: 15,
+    discount: 30, couponDiscount: 30, autoDiscount: 0,
+    taxAmount: 9.5, grandTotal: 289.5
+  }
+};
+const rows = EWBill.rowsFromQuote(profitableQuote);
+const keys = rows.map(r => r.key);
+ok('bill: food row present', keys.includes('foodSubtotal'));
+ok('bill: delivery row present', keys.includes('deliveryFee'));
+ok('bill: small-order fee row present', keys.includes('smallOrderFee'));
+ok('bill: COD fee row present', keys.includes('codFee'));
+ok('bill: coupon row present', keys.includes('couponDiscount'));
+ok('bill: taxes row present', keys.includes('taxes'));
+ok('bill: total row present', keys.includes('total'));
+eq('bill: total displays backend grandTotal', rows.find(r => r.key === 'total').display, '₹289.5');
+ok('bill: food note mentions the backend uplift', rows.find(r => r.key === 'foodSubtotal').note.includes('₹12'));
+
+/* A COD fee of 0 must not be shown (UPI quote). */
+const upiQuote = JSON.parse(JSON.stringify(profitableQuote));
+upiQuote.bill.codFee = 0;
+ok('bill: no COD fee row for a UPI quote',
+  !EWBill.rowsFromQuote(upiQuote).map(r => r.key).includes('codFee'));
+
+/* ── 3. The three decisions ─────────────────────────────────────── */
+eq('decision: profitable does not block', EWBill.decision({ decision: 'PROFITABLE' }).blocksCheckout, false);
+const repricing = EWBill.decision({ decision: 'REPRICING_REQUIRED', reason: 'surge' });
+eq('decision: repricing does not hard-block', repricing.blocksCheckout, false);
+eq('decision: repricing title', repricing.title, 'Price updated');
+const blocked = EWBill.decision({ decision: 'NOT_ECONOMICALLY_SERVICEABLE', selfDeliveryAvailable: true, message: 'too far' });
+eq('decision: not-serviceable blocks', blocked.blocksCheckout, true);
+eq('decision: not-serviceable offers self delivery', blocked.offerSelfDelivery, true);
+eq('decision: not-serviceable uses backend message', blocked.message, 'too far');
+
+/* ── 4. diffBills highlights what changed ───────────────────────── */
+const changed = JSON.parse(JSON.stringify(profitableQuote));
+changed.bill.deliveryFee = 50;
+changed.bill.grandTotal = 304.5;
+const diffs = EWBill.diffBills(profitableQuote, changed);
+ok('diff: detects the delivery fee change', diffs.some(d => d.key === 'deliveryFee'));
+ok('diff: detects the total change', diffs.some(d => d.key === 'total'));
+ok('diff: no diff for identical bills', EWBill.diffBills(profitableQuote, profitableQuote).length === 0);
+
+/* ── 5. QuoteController: debounce, stale, expiry, confirmation ──── */
+/* Fake fetch that resolves on demand, echoing a marker. */
+let fetchCalls = [];
+let resolvers = [];
+global.fetch = function (url, init) {
+  const idx = fetchCalls.length;
+  fetchCalls.push({ url, init, body: init && init.body ? JSON.parse(init.body) : null });
+  return new Promise((resolve) => {
+    resolvers.push((payload) => resolve({
+      status: 200,
+      text: () => Promise.resolve(JSON.stringify({ success: true, data: payload || { quoteId: 'q_' + idx, serviceable: true, decision: 'PROFITABLE', bill: { grandTotal: 100 + idx } } }))
+    }));
+  });
+};
+
+(async function run() {
+  /* 5a. Payload only ever carries ids, quantities, address, method, coupon. */
+  const payload = EWQuote.buildPayload({
+    restaurantId: 'r1', addressId: 'a1', paymentMethod: 'cod', couponCode: 'SAVE10',
+    items: [{ menuItem: 'm1', quantity: 2, price: 999, name: 'x' }, { menuItem: 'm2', quantity: 1 }]
+  });
+  eq('payload: restaurantId', payload.restaurantId, 'r1');
+  eq('payload: addressId', payload.addressId, 'a1');
+  eq('payload: paymentMethod', payload.paymentMethod, 'cod');
+  eq('payload: couponCode', payload.couponCode, 'SAVE10');
+  eq('payload: item count', payload.items.length, 2);
+  ok('payload: item has NO client price', payload.items[0].price === undefined);
+  ok('payload: item has NO client name', payload.items[0].name === undefined);
+  eq('payload: item is id+quantity only', JSON.stringify(payload.items[0]), JSON.stringify({ menuItem: 'm1', quantity: 2 }));
+
+  /* 5b. Debounce collapses rapid changes to the latest. */
+  fetchCalls = []; resolvers = [];
+  const ctrl = EWQuote.Controller({ debounceMs: 10 });
+  const p1 = ctrl.request({ restaurantId: 'r', addressId: 'a', items: [{ menuItem: 'm', quantity: 1 }] });
+  const p2 = ctrl.request({ restaurantId: 'r', addressId: 'a', items: [{ menuItem: 'm', quantity: 3 }] });
+  await new Promise(r => setTimeout(r, 30));
+  eq('quote: debounce collapses to one call', fetchCalls.length, 1);
+  eq('quote: debounce sends the latest quantity', fetchCalls[0].body.items[0].quantity, 3);
+  resolvers.forEach(fn => fn({ quoteId: 'q', serviceable: true, decision: 'PROFITABLE', bill: { grandTotal: 120 } }));
+  const [ra, rb] = await Promise.all([p1, p2]);
+  ok('quote: superseded request resolved (never hangs)', ra !== undefined);
+  ok('quote: latest delivered', rb && rb.quote && rb.quote.quoteId === 'q');
+
+  /* 5c. Stale response: A slow, B fast — only B wins. */
+  fetchCalls = []; resolvers = [];
+  const ctrl2 = EWQuote.Controller({ debounceMs: 0 });
+  const a = ctrl2.requestNow({ restaurantId: 'r', addressId: 'a', items: [{ menuItem: 'm', quantity: 1 }] });
+  const b = ctrl2.requestNow({ restaurantId: 'r', addressId: 'a', items: [{ menuItem: 'm', quantity: 2 }] });
+  await new Promise(r => setTimeout(r, 5));
+  if (resolvers[1]) resolvers[1]({ quoteId: 'qB', serviceable: true, decision: 'PROFITABLE', bill: { grandTotal: 200 } });
+  await new Promise(r => setTimeout(r, 5));
+  if (resolvers[0]) resolvers[0]({ quoteId: 'qA', serviceable: true, decision: 'PROFITABLE', bill: { grandTotal: 100 } });
+  const [resA, resB] = await Promise.all([a, b]);
+  ok('quote: older response is stale', resA && resA.stale === true);
+  eq('quote: newest quote wins', ctrl2.quoteId(), 'qB');
+  near('quote: newest total kept', ctrl2.total(), 200);
+
+  /* 5d. Expiry countdown from the backend's quoteExpiresAt. */
+  eq('quote: secondsRemaining from expiry',
+    EWQuote.secondsRemaining({ quoteExpiresAt: new Date(Date.now() + 5000).toISOString() }), 5);
+  ok('quote: isExpired false while valid',
+    EWQuote.isExpired({ quoteExpiresAt: new Date(Date.now() + 5000).toISOString() }) === false);
+  ok('quote: isExpired true in the past',
+    EWQuote.isExpired({ quoteExpiresAt: new Date(Date.now() - 1000).toISOString() }) === true);
+  eq('quote: no expiry -> null seconds', EWQuote.secondsRemaining({}), null);
+
+  /* 5e. A backend reprice requires explicit confirmation. */
+  fetchCalls = []; resolvers = [];
+  const ctrl3 = EWQuote.Controller({ debounceMs: 0 });
+  const c1 = ctrl3.requestNow({ restaurantId: 'r', addressId: 'a', items: [{ menuItem: 'm', quantity: 1 }] });
+  await new Promise(r => setTimeout(r, 2));
+  resolvers[0]({ quoteId: 'q1', serviceable: true, decision: 'PROFITABLE', bill: { grandTotal: 100 } });
+  await c1;
+  eq('quote: first total is the baseline', ctrl3.total(), 100);
+  eq('quote: no confirmation needed yet', ctrl3.needsConfirmation(), false);
+
+  fetchCalls = []; resolvers = [];
+  const c2 = ctrl3.requestNow({ restaurantId: 'r', addressId: 'a', items: [{ menuItem: 'm', quantity: 1 }] });
+  await new Promise(r => setTimeout(r, 2));
+  resolvers[0]({ quoteId: 'q2', serviceable: true, decision: 'REPRICING_REQUIRED', bill: { grandTotal: 130 } });
+  await c2;
+  eq('quote: reprice needs confirmation', ctrl3.needsConfirmation(), true);
+  near('quote: reprice total updated', ctrl3.total(), 130);
+  ctrl3.confirm();
+  eq('quote: confirm clears the flag', ctrl3.needsConfirmation(), false);
+
+  /* 5f. A customer-initiated change resets the baseline (no false reprice). */
+  ctrl3.resetBaseline();
+  eq('quote: reset drops the baseline', ctrl3.confirmedTotal(), null);
+
+  /* 5g. Quote-error codes trigger a re-quote rather than a generic error. */
+  ok('quote: QUOTE_EXPIRED recognised', EWQuote.isQuoteCode('QUOTE_EXPIRED') === true);
+  ok('quote: QUOTE_PRICE_CHANGED recognised', EWQuote.isQuoteCode('QUOTE_PRICE_CHANGED') === true);
+  ok('quote: QUOTE_MISMATCH recognised', EWQuote.isQuoteCode('QUOTE_MISMATCH') === true);
+  ok('quote: an unrelated code is not a quote code', EWQuote.isQuoteCode('SOMETHING_ELSE') === false);
+
+  /* 5h. NOT_ECONOMICALLY_SERVICEABLE (409) keeps its code and quote. */
+  global.fetch = function () {
+    return Promise.resolve({ status: 409, text: () => Promise.resolve(JSON.stringify({
+      success: false, code: 'NOT_ECONOMICALLY_SERVICEABLE', message: 'too far',
+      data: { decision: 'NOT_ECONOMICALLY_SERVICEABLE', serviceable: false, selfDeliveryAvailable: true }
+    })) });
+  };
+  const nres = await EWQuote.Controller({ debounceMs: 0 }).requestNow({ restaurantId: 'r', addressId: 'a', items: [{ menuItem: 'm', quantity: 1 }] });
+  eq('quote: 409 not ok', nres.ok, false);
+  eq('quote: 409 keeps the code', nres.code, 'NOT_ECONOMICALLY_SERVICEABLE');
+  eq('quote: 409 keeps the quote data', nres.quote && nres.quote.decision, 'NOT_ECONOMICALLY_SERVICEABLE');
+
+  /* 5i. A network failure never throws. */
+  global.fetch = function () { return Promise.reject(new Error('offline')); };
+  let threw = false;
+  let fres = null;
+  try { fres = await EWQuote.Controller({ debounceMs: 0 }).requestNow({ restaurantId: 'r', addressId: 'a', items: [{ menuItem: 'm', quantity: 1 }] }); }
+  catch (e) { threw = true; }
+  ok('quote: network failure does not throw', threw === false);
+  ok('quote: network failure reports not ok', fres && fres.ok === false);
+
+  /* ── 6. Source wiring of the cart page ───────────────────────── */
+  const cartPage = read('js/cart-page.js');
+  const orderPayload = read('js/order-payload.js');
+  const cartHtml = read('cart.html');
+
+  ok('cart: re-quotes on bill change (applyTotals)', /EWCartQuoteUI\.schedule\(\)/.test(cartPage));
+  ok('cart: gates Pay on a fresh quote', /EWCartQuoteUI\.ensureForPay\(\)/.test(cartPage));
+  ok('cart: sends the quoteId with the order', /quoteId:\s*ctQuoteId/.test(cartPage));
+  ok('cart: blocks Pay when the backend says not serviceable', /q\.blocked/.test(cartPage));
+  ok('cart: requires confirmation on a reprice', /q\.needsConfirmation/.test(cartPage));
+  ok('cart: handles quote-specific error codes', /EWQuote\.isQuoteCode\(/.test(cartPage));
+  ok('order payload: forwards quoteId', /payload\.quoteId\s*=\s*String\(o\.quoteId\)/.test(orderPayload));
+  ok('order payload: still sends the payment method', /paymentMethod:\s*method/.test(orderPayload));
+  ok('cart page loads the quote module before the UI', cartHtml.indexOf('js/ew-quote.js') > -1 &&
+    cartHtml.indexOf('js/ew-quote.js') < cartHtml.indexOf('js/cart-quote-ui.js'));
+  ok('cart page loads the quote UI before cart-page.js',
+    cartHtml.indexOf('js/cart-quote-ui.js') < cartHtml.search(/cart-page\.js/));
+
+  /* The Pay button is locked while an order is in flight. */
+  ok('cart: Pay is disabled while in flight', /ctOrderInFlight\s*=\s*true/.test(cartPage) &&
+    /ctSetCheckoutButton\(\s*btn,/.test(cartPage));
+
+  /* No client-computed total is sent to the payment endpoints. */
+  const paymentVerify = read('js/payment-verify.js');
+  ok('payment: verify sends no client total', !/body:\s*JSON\.stringify\([^)]*\btotal\b/.test(paymentVerify));
+
+  /* Switching UPI <-> COD must re-quote: the COD handling fee applies to COD
+     only, so the bill the customer saw for UPI is not the bill for COD. */
+  ok('cart: a payment-method switch re-quotes', /ctLastQuoteMethod/.test(cartPage) &&
+    /EWCartQuoteUI\.onBasketChanged\(\)/.test(cartPage));
+  ok('cart: the quote method baseline is tracked', /let ctLastQuoteMethod/.test(cartPage));
+
+  /* The discount funding source is the backend's own label, rendered as a note. */
+  const bill = read('js/ew-bill.js');
+  ok('bill: coupon funding source comes from the backend',
+    /promotionFundingSource/.test(bill) && /Funded by /.test(bill));
+
+  finish();
+})().catch(function (e) {
+  console.error('UNHANDLED ERROR IN TESTS:', (e && e.stack) || e);
+  process.exitCode = 1;
+});
+
+function finish() {
+  console.log('\n────────────────────────────────────────────────────');
+  console.log('  ' + passed + ' passed, ' + failed + ' failed');
+  if (failures.length) { console.log('\nFailures:'); failures.forEach(f => console.log('  • ' + f)); }
+  console.log('────────────────────────────────────────────────────');
+  process.exitCode = failed ? 1 : 0;
+}
