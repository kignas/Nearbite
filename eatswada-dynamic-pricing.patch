+'use strict';
+/* ================================================================
+   Eatswada dynamic-pricing customer modules — self-contained tests.
+
+   Usage: node tests/ew-modules.test.js
+
+   No dependencies. The modules under test are UMD (they export via
+   module.exports in Node and attach to window in the browser), so they
+   are required directly. A tiny fake window/localStorage/sessionStorage
+   is installed for the tracking module, and global.fetch is mocked for
+   the pricing controller.
+   ================================================================ */
+
+const path = require('path');
+const root = path.resolve(__dirname, '..');
+function req(name) { return require(path.join(root, name)); }
+
+let passed = 0, failed = 0;
+const failures = [];
+function ok(label, cond) {
+  if (cond) { passed++; }
+  else { failed++; failures.push(label); }
+}
+function eq(label, actual, expected) {
+  if (actual === expected) { passed++; }
+  else { failed++; failures.push(label + ' — expected ' + JSON.stringify(expected) + ' got ' + JSON.stringify(actual)); }
+}
+
+/* ── fake browser storage ─────────────────────────────────────── */
+function makeStorage() {
+  const m = new Map();
+  return {
+    getItem: (k) => (m.has(k) ? m.get(k) : null),
+    setItem: (k, v) => { m.set(k, String(v)); },
+    removeItem: (k) => { m.delete(k); },
+    _map: m
+  };
+}
+
+/* ══════════════════════════════════════════════════════════════
+   1. EWMoney — money formatting edge cases
+   ══════════════════════════════════════════════════════════════ */
+const EWMoney = req('js/ew-money.js');
+
+eq('money: 0', EWMoney.format(0), '₹0');
