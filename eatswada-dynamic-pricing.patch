+'use strict';
+/* ================================================================
+   Phase 2 — single tracking module, wired into menu / cart / checkout.
+
+   Usage: node tests/ew-phase2.test.js
+
+   No dependencies. These are contract tests over the real files:
+     • the tracking module is the ONE analytics system in the repo;
+     • the pages load it exactly once, before the code that uses it;
+     • the menu, dish-detail and cart surfaces call it at the right
+       points with the backend's own event names and fields;
+     • the module itself never lets a tracking failure reach the UI.
+
+   A static source check is used deliberately: the alternative would be
+   driving a real browser, and the repo has no browser test harness.
+   ================================================================ */
+
+const fs = require('fs');
+const path = require('path');
+const root = path.resolve(__dirname, '..');
+
+let passed = 0, failed = 0;
+const failures = [];
+function ok(label, cond) {
+  if (cond) passed++; else { failed++; failures.push(label); }
+}
+
+function read(f) { return fs.readFileSync(path.join(root, f), 'utf8'); }
+
+/* Every .js file in the repo (excluding tests and junk dirs). */
+function jsFiles(dir, acc) {
+  acc = acc || [];
+  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+    const name = entry.name;
+    if (name === 'node_modules' || name === '.git' || name === '.openhands' || name === 'tests') continue;
+    const full = path.join(dir, name);
+    if (entry.isDirectory()) jsFiles(full, acc);
+    else if (name.endsWith('.js')) acc.push(full);
+  }
+  return acc;
+}
+
+/* ── 1. One analytics system ─────────────────────────────────────── */
+const files = jsFiles(root);
+const analyticsPosts = files.filter(function (f) {
+  const s = fs.readFileSync(f, 'utf8');
+  return /\/analytics\/visit/.test(s);
+});
+ok('single analytics poster (only js/ew-tracking.js posts /analytics/visit)',
+  analyticsPosts.length === 1 && analyticsPosts[0].endsWith(path.join('js', 'ew-tracking.js')));
+
+const windowAnalytics = files.filter(function (f) {
+  return /\.EWAnalytics\s*=\s*api/.test(fs.readFileSync(f, 'utf8'));
+});
+ok('single analytics module definition (EWAnalytics)',
+  windowAnalytics.length === 1 && windowAnalytics[0].endsWith(path.join('js', 'ew-tracking.js')));
+
+/* No competing view-tracking system (e.g. a second beacon/GA/gtag tracker). */
+const competing = files.filter(function (f) {
+  const s = fs.readFileSync(f, 'utf8');
+  if (f.endsWith(path.join('js', 'ew-tracking.js'))) return false;
+  return /gtag\(|googletagmanager|navigator\.sendBeacon\(|firebase\.analytics|logEvent\(/.test(s);
+});
+ok('no competing tracking system in the repo', competing.length === 0);
+
+/* ── 2. Pages load the module exactly once, before its users ─────── */
+function scriptOrder(html) {
+  const out = [];
+  const re = /<script[^>]*\bsrc=["']([^"']+)["'][^>]*>/g;
+  let m;
+  while ((m = re.exec(html)) !== null) out.push(m[1].split('?')[0]);
+  return out;
+}
+
+const shell = read('restaurant-shell.html');
+const shellScripts = scriptOrder(shell);
+ok('menu page loads the tracking module',
+  shellScripts.filter(s => s === 'js/ew-tracking.js').length === 1);
+ok('menu page loads tracking before cart-bar.js',
+  shellScripts.indexOf('js/ew-tracking.js') > -1 &&
+  shellScripts.indexOf('js/ew-tracking.js') < shellScripts.indexOf('cart-bar.js'));
+
+const cart = read('cart.html');
+const cartScripts = scriptOrder(cart);
+ok('cart page loads the tracking module',
+  cartScripts.filter(s => s === 'js/ew-tracking.js').length === 1);
+ok('cart page loads tracking before cart-page.js',
+  cartScripts.indexOf('js/ew-tracking.js') > -1 &&
+  cartScripts.indexOf('js/ew-tracking.js') < cartScripts.findIndex(s => /cart-page\.js$/.test(s)));
+
+/* ── 3. Menu page: menu_view + item_view ────────────────────────── */
+ok('menu page emits menu_view once per restaurant',
+  /EWAnalytics\.menuViewOnce\(resId/.test(shell));
+ok('menu page emits item_view when a dish detail opens',
+  /EWAnalytics\.itemView\(currentResId/.test(shell));
+ok('item_view passes the menu item id from the backend',
+  /itemView\(currentResId,\s*e\.item\._id\s*\|\|\s*e\.item\.id/.test(shell));
+
+/* The restaurant's own availability class drives the menu's add blocking. */
+ok('menu page consults the backend availability class',
+  /EWAvailability\.classify\(restaurant\)/.test(shell));
+ok('menu page free-delivery banner uses the pricing card block',
+  /EWPricing\.restaurantCardsNow/.test(shell) && /EWFreeDelivery\.line/.test(shell));
+
+/* ── 4. Cart: add/remove from the one choke point, checkout at order ── */
+const cartBar = read('cart-bar.js');
+ok('cart add/remove is tracked at the single updateCart choke point',
+  /EWAnalytics\.addToCart\(/.test(cartBar) && /EWAnalytics\.removeFromCart\(/.test(cartBar));
+
+const cartPage = read('js/cart-page.js');
+ok('cart page emits checkout_initiated once when Order is pressed',
+  /EWAnalytics\.checkoutInitiatedOnce\(/.test(cartPage));
+
+/* ── 5. Module behaviour (real code, fake transport) ─────────────── */
+const EWAnalytics = require(path.join(root, 'js', 'ew-tracking.js'));
+
+/* Fake browser storage before any call. */
+const sessionStore = (function () {
+  const m = new Map();
+  return {
+    getItem: k => (m.has(k) ? m.get(k) : null),
+    setItem: (k, v) => m.set(k, String(v)),
+    removeItem: k => m.delete(k),
+    _map: m
+  };
+})();
+const localStore = (function () {
+  const m = new Map();
+  return { getItem: k => (m.has(k) ? m.get(k) : null), setItem: (k, v) => m.set(k, String(v)), removeItem: k => m.delete(k) };
+})();
+global.window = {
+  sessionStorage: sessionStore,
+  localStorage: localStore,
+  CONFIG: { API_BASE_URL: 'https://example.test/api' },
+  location: { href: '' }
+};
+global.document = { referrer: '' };
+
+let sends = [];
+EWAnalytics.setTransport(function (url, body) { sends.push({ url, body }); return Promise.resolve(); });
+
+/* Event names must be exactly the backend whitelist. */
+EWAnalytics._resetThrottle();
+EWAnalytics.menuView('r1');
+EWAnalytics.itemView('r1', 'i1');
+EWAnalytics.addToCart('r1', 'i1');
+EWAnalytics.removeFromCart('r1', 'i1');
+EWAnalytics.checkoutInitiated('r1');
+const types = sends.map(s => s.body.eventType);
+ok('event names match the backend whitelist',
+  types.join(',') === 'menu_view,item_view,add_to_cart,remove_from_cart,checkout_initiated');
+
+/* Every event carries the required fields. */
+ok('every event carries restaurantId/sessionId/eventKey/clientTimestamp/source',
+  sends.every(s => s.body.sessionId && s.body.eventKey && s.body.clientTimestamp && s.body.source === 'web'));
+
+/* Guests and logged-in users: no token is required to send. */
+ok('tracking works without a token (guest)', sends.length === 5);
+
+/* Dedupe across a refresh: same subject, same eventKey inside the window. */
+EWAnalytics._resetThrottle();
+const first = EWAnalytics.menuView('r2');
+EWAnalytics._resetThrottle();
+const again = EWAnalytics.menuView('r2');
+ok('a refresh reuses the eventKey (backend dedupes to one row)', again.eventKey === first.eventKey);
+
+/* Failure isolation: a transport that throws must not reach the caller. */
+EWAnalytics.setTransport(function () { throw new Error('boom'); });
+EWAnalytics._resetThrottle();
+let threw = false, res = null;
+try { res = EWAnalytics.itemView('r3', 'i3'); } catch (e) { threw = true; }
+ok('a throwing transport never throws into the UI', threw === false);
+ok('a throwing transport reports not-sent', res && res.sent === false);
+
+/* Stale/deduped events still return a descriptor, never undefined. */
+EWAnalytics.setTransport(function () { return Promise.resolve(); });
+EWAnalytics._resetThrottle();
+const dup = EWAnalytics.itemView('r4', 'i4');
+EWAnalytics._resetThrottle();
+ok('a re-view returns a descriptor', dup && typeof dup === 'object');
+
+console.log('\n────────────────────────────────────────────────────');
+console.log('  ' + passed + ' passed, ' + failed + ' failed');
+if (failures.length) { console.log('\nFailures:'); failures.forEach(f => console.log('  • ' + f)); }
+console.log('────────────────────────────────────────────────────');
+process.exitCode = failed ? 1 : 0;
