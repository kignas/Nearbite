+const EWAnalytics = req('js/ew-tracking.js');
+
+let sentCalls = [];
+EWAnalytics.setTransport(function (url, body) { sentCalls.push({ url, body }); return Promise.resolve(); });
+EWAnalytics._resetThrottle();
+fakeSession._map.clear();
