+/* ══════════════════════════════════════════════════════════════
+   5. EWAnalytics — dedupe, StrictMode, failure isolation, storage
+   ══════════════════════════════════════════════════════════════ */
+// Install a fake window BEFORE calling the tracking module functions.
+const fakeSession = makeStorage();
+const fakeLocal = makeStorage();
+global.window = { sessionStorage: fakeSession, localStorage: fakeLocal, CONFIG: { API_BASE_URL: 'https://example.test/api' }, EWAuth: { getToken: () => '' } };
+global.document = { referrer: '' };
