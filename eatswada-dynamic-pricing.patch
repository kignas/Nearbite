+// First menu view
+let r1 = EWAnalytics.menuView('res1');
+eq('tracking: first view sent', r1.sent, true);
+eq('tracking: url correct', sentCalls[0].url, 'https://example.test/api/analytics/visit');
+eq('tracking: eventType', sentCalls[0].body.eventType, 'menu_view');
+eq('tracking: restaurantId', sentCalls[0].body.restaurantId, 'res1');
+ok('tracking: has eventKey', !!sentCalls[0].body.eventKey);
+ok('tracking: has sessionId', !!sentCalls[0].body.sessionId);
+ok('tracking: has clientTimestamp', !!sentCalls[0].body.clientTimestamp);
+eq('tracking: source web', sentCalls[0].body.source, 'web');
+
+// Immediate repeat (StrictMode double-effect) is throttled
+let r2 = EWAnalytics.menuView('res1');
+eq('tracking: StrictMode repeat throttled', r2.sent, false);
+eq('tracking: StrictMode repeat reason', r2.reason, 'throttled');
+eq('tracking: only one network send', sentCalls.length, 1);
+
+// After the throttle window, same subject reuses the SAME eventKey (dedupe)
+EWAnalytics._resetThrottle();
+let r3 = EWAnalytics.menuView('res1');
+eq('tracking: refresh reuses eventKey (deduped)', r3.eventKey, r1.eventKey);
+eq('tracking: refresh deduped flag', r3.deduped, true);
+
+// Different subject gets a different key
+let r4 = EWAnalytics.menuView('res2');
+ok('tracking: different restaurant new key', r4.eventKey !== r1.eventKey);
+
+// sessionId is stable within a session and lives in sessionStorage only
+const sid1 = EWAnalytics.sessionId();
+const sid2 = EWAnalytics.sessionId();
+eq('tracking: sessionId stable', sid1, sid2);
+ok('tracking: sessionId stored in sessionStorage', fakeSession.getItem(EWAnalytics.SESSION_KEY) === sid1);
+eq('tracking: no session key in localStorage', fakeLocal.getItem(EWAnalytics.SESSION_KEY), null);
+
+// add_to_cart / remove_from_cart / checkout_initiated are allowed
+EWAnalytics._resetThrottle();
+eq('tracking: add_to_cart allowed', EWAnalytics.addToCart('res1', 'item1').sent, true);
+EWAnalytics._resetThrottle();
+eq('tracking: remove_from_cart allowed', EWAnalytics.removeFromCart('res1', 'item1').sent, true);
+EWAnalytics._resetThrottle();
+eq('tracking: checkout_initiated allowed', EWAnalytics.checkoutInitiated('res1').sent, true);
+
+// Outcome events are rejected client-side (server-only)
+eq('tracking: order_completed rejected', EWAnalytics.track('order_completed', { restaurantId: 'res1' }).sent, false);
+
+// item_view is allowed and carries the menu item id
+EWAnalytics._resetThrottle();
+let rItem = EWAnalytics.itemView('res1', 'item7');
+eq('tracking: item_view allowed', rItem.sent, true);
+eq('tracking: item_view menuItemId', rItem.body.menuItemId, 'item7');
+
+// menuViewOnce / checkoutInitiatedOnce fire at most once per subject per load,
+// regardless of how many times a re-render or StrictMode double-effect runs.
+EWAnalytics._resetThrottle();
+let once1 = EWAnalytics.menuViewOnce('resA');
+let once2 = EWAnalytics.menuViewOnce('resA');
+eq('tracking: menuViewOnce first fires', once1.sent, true);
+eq('tracking: menuViewOnce repeat blocked', once2.sent, false);
+eq('tracking: menuViewOnce repeat reason', once2.reason, 'already_fired');
