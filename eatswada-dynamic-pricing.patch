+eq('tracking: checkoutInitiatedOnce repeat blocked', EWAnalytics.checkoutInitiatedOnce('resA').sent, false);
+
+// Failure isolation: a throwing transport must not throw into the caller
+EWAnalytics.setTransport(function () { throw new Error('boom'); });
+EWAnalytics._resetThrottle();
+let r5;
+try { r5 = EWAnalytics.menuView('res9'); ok('tracking: throwing transport did not throw', true); }
+catch (e) { ok('tracking: throwing transport did not throw', false); }
+ok('tracking: throwing transport reports not-sent', r5 && r5.sent === false);
