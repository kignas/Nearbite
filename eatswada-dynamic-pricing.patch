+/* ══════════════════════════════════════════════════════════════
+   6. EWPricing — QuoteController debounce + stale-response handling
+   ══════════════════════════════════════════════════════════════ */
+const EWPricing = req('js/ew-pricing.js');
+
+// Mock fetch: each call resolves after a controllable delay, echoing a marker.
+let fetchCalls = [];
+let resolvers = [];
+global.fetch = function (url, init) {
+  const idx = fetchCalls.length;
+  fetchCalls.push({ url, init, body: init && init.body ? JSON.parse(init.body) : null });
+  return new Promise((resolve) => {
+    resolvers.push(() => resolve({
+      status: 200,
+      text: () => Promise.resolve(JSON.stringify({ success: true, data: { quoteId: 'q_' + idx, marker: idx } }))
+    }));
+  });
+};
+
+(async function runPricingTests() {
+  // Debounce: two rapid requests -> only the last one is delivered (stale ignored)
+  fetchCalls = []; resolvers = [];
+  const ctrl = new EWPricing.QuoteController({ debounceMs: 10 });
+  const p1 = ctrl.request({ restaurantId: 'r', items: [{ menuItem: 'm', quantity: 1 }] });
+  const p2 = ctrl.request({ restaurantId: 'r', items: [{ menuItem: 'm', quantity: 2 }] });
+  await new Promise(r => setTimeout(r, 30));
+  // Only one network call should have been issued (debounced).
+  eq('pricing: debounce collapses to one call', fetchCalls.length, 1);
+  eq('pricing: debounce sends latest payload', fetchCalls[0].body.items[0].quantity, 2);
+  // resolve it
+  resolvers.forEach(r => r());
+  const [res1, res2] = await Promise.all([p1, p2]);
+  // p1 was superseded before it ran -> stale; p2 delivered
+  ok('pricing: superseded request is stale', res1 && (res1.stale === true || (res2 && res2.marker !== undefined)));
+  ok('pricing: latest request delivered', res2 && res2.quote && res2.quote.marker !== undefined);
+
+  // Stale-response: request A slow, request B fast -> only B wins.
+  fetchCalls = []; resolvers = [];
+  const ctrl2 = new EWPricing.QuoteController({ debounceMs: 0 });
+  const a = ctrl2.requestNow({ restaurantId: 'r', items: [{ menuItem: 'm', quantity: 1 }] });
+  const b = ctrl2.requestNow({ restaurantId: 'r', items: [{ menuItem: 'm', quantity: 2 }] });
+  await new Promise(r => setTimeout(r, 5));
+  // resolve B first (index 1), then A (index 0)
+  if (resolvers[1]) resolvers[1]();
+  await new Promise(r => setTimeout(r, 5));
+  if (resolvers[0]) resolvers[0]();
+  const [ra, rb] = await Promise.all([a, b]);
+  ok('pricing: older response marked stale', ra && ra.stale === true);
+  ok('pricing: newest response not stale', rb && rb.stale !== true && rb.quote && rb.quote.marker === 1);
+
+  // Error normalisation: 409 not-serviceable keeps code + quote
+  global.fetch = function () {
+    return Promise.resolve({ status: 409, text: () => Promise.resolve(JSON.stringify({ success: false, code: 'NOT_ECONOMICALLY_SERVICEABLE', message: 'nope', data: { decision: 'NOT_ECONOMICALLY_SERVICEABLE' } })) });
+  };
+  const n = EWPricing.normalise(409, { success: false, code: 'NOT_ECONOMICALLY_SERVICEABLE', message: 'nope', data: { decision: 'NOT_ECONOMICALLY_SERVICEABLE' } });
+  eq('pricing: 409 not ok', n.ok, false);
+  eq('pricing: 409 keeps code', n.code, 'NOT_ECONOMICALLY_SERVICEABLE');
+  ok('pricing: 409 keeps quote data', n.quote && n.quote.decision === 'NOT_ECONOMICALLY_SERVICEABLE');
+
+  const r = await EWPricing.quoteNow({ restaurantId: 'r', items: [] });
+  eq('pricing: quoteNow 409 normalised', r.code, 'NOT_ECONOMICALLY_SERVICEABLE');
+
+  finish();
+})().catch(function (e) {
+  console.error('UNHANDLED ERROR IN TESTS:', e && e.stack || e);
+  process.exitCode = 1;
+});
+
+function finish() {
+  console.log('\n────────────────────────────────────────────────────');
+  console.log('  ' + passed + ' passed, ' + failed + ' failed');
+  if (failures.length) {
+    console.log('\nFailures:');
+    failures.forEach(f => console.log('  • ' + f));
+  }
+  console.log('────────────────────────────────────────────────────');
+  /* Set exitCode rather than calling process.exit(): exit() can truncate
+     piped stdout before the buffered log lines are flushed. */
+  process.exitCode = failed ? 1 : 0;
+}
