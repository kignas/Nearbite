@@ -0,0 +1,100 @@
+'use strict';
+/* ================================================================
+   Phase 4 — orders, tracking, history, invoice.
+
+   Usage: node tests/ew-phase4.test.js
+
+   No dependencies. Verifies that every place showing money on the order
+   surfaces renders the backend's STORED order bill (order.bill) and never
+   recomputes a charge, and that legacy orders without a bill keep the
+   existing computed summary.
+
+   Backend reference (cloned backend, commit 2139abb):
+     models/Order.js   order.bill (itemSubtotal, deliveryFee, smallCartFee,
+                       codFee, couponDiscount, autoDiscount, taxAmount,
+                       deliverySubsidy, tipAmount, grandTotal, …)
+     controllers/orderController.js   GET /orders, GET /orders/:id
+   ================================================================ */
+
+const fs = require('fs');
+const path = require('path');
+const root = path.resolve(__dirname, '..');
+function req(name) { return require(path.join(root, name)); }
+function read(f) { return fs.readFileSync(path.join(root, f), 'utf8'); }
+
+let passed = 0, failed = 0;
+const failures = [];
+function ok(label, cond) { if (cond) passed++; else { failed++; failures.push(label); } }
+function eq(label, a, b) { if (a === b) passed++; else { failed++; failures.push(label + ' — expected ' + JSON.stringify(b) + ' got ' + JSON.stringify(a)); } }
+
+const EWBill = req('js/ew-bill.js');
+
+/* ── 1. Stored bill rows (engine order) ─────────────────────────── */
+const engineOrder = {
+  _id: 'o1', total: 289.5, grandTotal: 289.5,
+  bill: {
+    itemSubtotal: 228, customerFoodSubtotal: 228, foodUplift: 12,
+    deliveryFee: 35, deliverySubsidy: 0, isFreeDeliveryApplied: false,
+    smallCartFee: 20, codFee: 15, platformHandlingFee: 0, rainSurgeFee: 0,
+    discountAmount: 30, couponDiscount: 30, autoDiscount: 0,
+    taxAmount: 9.5, tipAmount: 0, grandTotal: 289.5
+  }
+};
+const rows = EWBill.rowsFromStoredBill(engineOrder);
+const keys = rows.map(r => r.key);
+ok('stored: item total present', keys.includes('foodSubtotal'));
+ok('stored: delivery fee present', keys.includes('deliveryFee'));
+ok('stored: small order fee present', keys.includes('smallCartFee'));
+ok('stored: COD fee present', keys.includes('codFee'));
+ok('stored: discount present', keys.includes('discountAmount'));
+ok('stored: taxes present', keys.includes('taxAmount'));
+eq('stored: total uses grandTotal', rows.find(r => r.key === 'total').display, '₹289.5');
+
+/* A free-delivery engine order shows FREE, never a recomputed fee. */
+const freeOrder = JSON.parse(JSON.stringify(engineOrder));
+freeOrder.bill.deliveryFee = 0; freeOrder.bill.deliverySubsidy = 35; freeOrder.bill.isFreeDeliveryApplied = true;
+const freeRows = EWBill.rowsFromStoredBill(freeOrder);
+eq('stored: free delivery renders FREE', freeRows.find(r => r.key === 'deliveryFee').display, 'FREE');
+ok('stored: free delivery notes the saving', freeRows.find(r => r.key === 'deliveryFee').note.includes('₹35'));
+
+/* Zero-value lines are not invented as rows. */
+const clean = EWBill.rowsFromStoredBill(engineOrder);
+ok('stored: zero COD fee omitted when 0', !EWBill.rowsFromStoredBill({ bill: { codFee: 0, itemSubtotal: 100, grandTotal: 100 } }).map(r => r.key).includes('codFee'));
+
+/* ── 2. Legacy order (no bill) still renders ────────────────────── */
+const legacy = EWBill.rowsFromStoredBill({ subtotal: 200, deliveryFee: 30, discount: 20, total: 210 });
+const lkeys = legacy.map(r => r.key);
+ok('legacy: item total present', lkeys.includes('foodSubtotal'));
+ok('legacy: delivery present', lkeys.includes('deliveryFee'));
+ok('legacy: discount present', lkeys.includes('discount'));
+ok('legacy: total present', lkeys.includes('total'));
+
+/* ── 3. Source wiring on the order pages ────────────────────────── */
+const trackOrder = read('track-order.html');
+const ordersHtml = read('orders.html');
+
+ok('track-order: renders the stored bill when present', /rowsFromStoredBill\(order\)/.test(trackOrder));
+ok('track-order: keeps the legacy summary as the fallback',
+  /Only rows for fields the backend really sent/.test(trackOrder));
+ok('track-order: loads the bill module', trackOrder.includes('js/ew-bill.js'));
+ok('track-order: stored bill drives the grand total', /order\.bill\.grandTotal/.test(trackOrder));
+
+ok('orders: invoice renders the stored bill when present', /rowsFromStoredBill\(o\)/.test(ordersHtml));
+ok('orders: loads the bill module', ordersHtml.includes('js/ew-bill.js'));
+ok('orders: invoice falls back to the legacy lines', /if \(!linesHtml\)/.test(ordersHtml));
+ok('orders: invoice total uses the stored grandTotal', /o\.bill\.grandTotal/.test(ordersHtml));
+
+/* ── 4. No recomputation of charges on the order surfaces ───────── */
+/* The invoice must never re-derive a total from items + fees. */
+ok('orders: invoice does not recompute a total from parts',
+  !/invMoney\(o\.subtotal\s*\+/.test(ordersHtml) && !/o\.total\s*=\s*/.test(ordersHtml));
+
+/* Refund / cancellation state still comes from the backend via order-status.js. */
+const orderStatus = read('order-status.js');
+ok('orders: refund state read from backend data', /refundState|refund/i.test(orderStatus));
+
+console.log('\n────────────────────────────────────────────────────');
+console.log('  ' + passed + ' passed, ' + failed + ' failed');
+if (failures.length) { console.log('\nFailures:'); failures.forEach(f => console.log('  • ' + f)); }
+console.log('────────────────────────────────────────────────────');
+process.exitCode = failed ? 1 : 0;
