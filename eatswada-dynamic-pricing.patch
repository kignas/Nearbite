new file mode 100644
index 0000000..625dc2c
--- /dev/null
+++ b/tests/ew-listing.test.js
@@ -0,0 +1,107 @@
+'use strict';
+/* ================================================================
+   Phase 1 — restaurant listing (ranking, availability, free delivery)
+
+   Usage: node tests/ew-listing.test.js
+
+   Self-contained (no dependencies), in the same style as the repo's other
+   tests. It checks:
+     • backend list ORDER is preserved end-to-end (no client re-sorting in the
+       enrichment helper) — order fidelity;
+     • offline restaurants are recognised and marked not-orderable;
+     • the three free-delivery display states produce the exact required copy;
+     • Sponsored/Featured labels come from the backend fields;
+     • the new modules never emit unescaped backend text themselves.
+   Rendering into real DOM markup (sponsor badge, muted offline card) is
+   covered by the manual staging steps in docs/rebuild/VERIFICATION.md.
+   ================================================================ */
+
+const path = require('path');
+const root = path.resolve(__dirname, '..');
+function req(name) { return require(path.join(root, name)); }
+
+let passed = 0, failed = 0;
+const failures = [];
+function ok(label, cond) { if (cond) passed++; else { failed++; failures.push(label); } }
+function eq(label, a, b) { if (a === b) passed++; else { failed++; failures.push(label + ' — expected ' + JSON.stringify(b) + ' got ' + JSON.stringify(a)); } }
+
+const EWAvailability = req('js/ew-availability.js');
+const EWFreeDelivery = req('js/ew-freedelivery.js');
+const EWRestaurantCards = req('js/ew-restaurant-cards.js');
+
+/* ── Backend order fidelity ───────────────────────────────────────
+   The list the backend returned (already ranked online-first, sponsored
+   pinned per the ranking engine) must survive enrichment unchanged. */
+const backendOrder = [
+  { _id: 'c', name: 'Third', availabilityStatus: 'orderable', sponsored: true, sponsoredLabel: 'Sponsored' },
+  { _id: 'a', name: 'First', availabilityStatus: 'orderable' },
+  { _id: 'b', name: 'Second', availabilityStatus: 'temporarily_closed' }
+];
+const cards = [
+  { restaurantId: 'a', serviceable: true, distanceKm: 2.1, deliveryFee: 20, effectiveDeliveryFee: 20, freeDelivery: { available: true, amountRemaining: 79, unlocked: false, deliveryFee: 20 } },
+  { restaurantId: 'b', serviceable: false, distanceKm: 9.4, reason: 'out_of_radius' },
+  { restaurantId: 'c', serviceable: true, distanceKm: 1.2, deliveryFee: 0, effectiveDeliveryFee: 0, freeDelivery: { available: true, unlocked: true, amountRemaining: 0 } }
+];
+const applied = EWRestaurantCards.applyCards(backendOrder, cards);
+eq('enrich: all three cards applied', applied, 3);
+eq('enrich: order[0] still c', backendOrder[0]._id, 'c');
+eq('enrich: order[1] still a', backendOrder[1]._id, 'a');
+eq('enrich: order[2] still b', backendOrder[2]._id, 'b');
+ok('enrich: pricing attached to a', backendOrder[1].pricing && backendOrder[1].pricing.distanceKm === 2.1);
+ok('enrich: pricing attached to c', backendOrder[0].pricing && backendOrder[0].pricing.freeDelivery.unlocked === true);
+
+/* ── Offline restaurants ──────────────────────────────────────── */
+eq('listing: offline (temporarily_closed) not orderable', EWAvailability.isOrderable(backendOrder[2]), false);
+eq('listing: online (orderable) is orderable', EWAvailability.isOrderable(backendOrder[0]), true);
+eq('listing: suspended hidden', EWAvailability.isVisible({ availabilityStatus: 'suspended' }), false);
+eq('listing: sponsored flag read', EWAvailability.isSponsored(backendOrder[0]), true);
+eq('listing: sponsored label read', EWAvailability.sponsoredLabel(backendOrder[0]), 'Sponsored');
+eq('listing: non-sponsored has no label', EWAvailability.sponsoredLabel(backendOrder[1]), '');
+
+/* ── Free-delivery states (exact copy) ────────────────────────── */
+const locked = { available: true, enabled: true, threshold: 299, eligibleSubtotal: 220, amountRemaining: 79, unlocked: false, deliveryFee: 25, effectiveDeliveryFee: 25 };
+eq('listing: locked copy', EWFreeDelivery.text(locked), 'Add ₹79 more to unlock free delivery');
+eq('listing: unlocked copy', EWFreeDelivery.text({ available: true, unlocked: true, amountRemaining: 0 }), 'Free delivery unlocked!');
+const unavailable = { available: false, deliveryFee: 40, effectiveDeliveryFee: 40, amountRemaining: null, unlocked: false };
+eq('listing: unavailable shows fee not progress', EWFreeDelivery.text(unavailable), '');
+eq('listing: unavailable fee text', EWFreeDelivery.state(unavailable).deliveryFeeText, '₹40 delivery');
+
+/* ── Sponsored/Featured labels never disguised ────────────────── */
+eq('listing: sponsored default label', EWAvailability.sponsoredLabel({ sponsored: true }), 'Sponsored');
+eq('listing: sponsored custom label', EWAvailability.sponsoredLabel({ sponsored: true, sponsoredLabel: 'Ad' }), 'Ad');
+eq('listing: featured flag', EWAvailability.isFeatured({ featured: true }), true);
+
+/* ── Escaping: backend text is escaped at the render sites ───────
+   Static contract: the listing surfaces wrap backend-provided text in the
+   page escaper before it reaches innerHTML. This mirrors the repo's existing
+   static-contract test style and fails loudly if a future edit drops esc(). */
+const fs = require('fs');
+function read(f) { return fs.readFileSync(path.join(root, f), 'utf8'); }
+function must(hay, needle, label) { if (hay.includes(needle)) passed++; else { failed++; failures.push(label + ' — missing ' + JSON.stringify(needle)); } }
+
+const card = read('restaurant-card.js');
+must(card, 'esc(window.EWAvailability.sponsoredLabel(r)', 'sponsored label is escaped on the home card');
+must(card, "esc(line)", 'free-delivery line is escaped on the home card');
+must(card, "homeBadgesMarkup(res)", 'home card renders ranking badges');
+must(card, "if (window.EWAvailability) {\n      var info = window.EWAvailability.classify(res);", 'home card prefers backend availability class');
+
+const category = read('category.html');
+must(category, 'esc(label)', 'category offline label is escaped');
+must(category, 'esc(freeLine)', 'category free-delivery line is escaped');
+must(category, 'res-card is-closed', 'category marks offline cards non-orderable');
+must(category, 'css/ew-pricing-ui.css', 'category loads the additive pricing stylesheet');
+
+const under99 = read('js/under99-products.js');
+must(under99, 'E.esc(freeLine)', '99-store free-delivery line is escaped');
+must(under99, 'E.esc(window.EWAvailability.sponsoredLabel(r)', '99-store sponsored label is escaped');
+must(read('js/under99-core.js'), 'function isOrderable(r)', '99-store has an orderable check');
+
+/* ── No client-side re-sorting was introduced ───────────────────── */
+ok('listing: home.js has no new client sort in enrichCards',
+  !/enrichCards[\s\S]{0,600}\.sort\(/.test(read('home.js')));
+
+console.log('\n────────────────────────────────────────────────────');
+console.log('  ' + passed + ' passed, ' + failed + ' failed');
+if (failures.length) { console.log('\nFailures:'); failures.forEach(f => console.log('  • ' + f)); }
+console.log('────────────────────────────────────────────────────');
+process.exitCode = failed ? 1 : 0;
