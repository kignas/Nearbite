{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/restaurant", "destination": "/api/restaurant-seo" }
  ],
  "headers": [
    {
      "source": "/restaurant-shell",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/restaurant-shell.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
